# Copia este archivo a .env y ajusta los valores para tu entorno local.

# Puerto del servidor HTTP (incluir el ":")
PORT=:8080

# Base de datos SQLite — se usa cuando DATABASE_URL no está definido
DB_PATH=garra.db

# PostgreSQL DSN — si se define, tiene prioridad sobre DB_PATH
# Ejemplo para docker-compose:
# DATABASE_URL=host=localhost user=garra password=garra dbname=garra port=5432 sslmode=disable

# Sembrar datos iniciales al arrancar (true/false)
SEED_ON_STARTUP=false
