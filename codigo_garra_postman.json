{
  "info": {
    "name": "Código Garra API",
    "_postman_id": "codigo-garra-api-h3",
    "description": "Colección completa de la API de emergencias veterinarias — TDI-601 H3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "tokenVet",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenAdmin",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar veterinario",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nuevo@vet.com\",\n  \"password\": \"Pass123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login veterinario (guarda token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('tokenVet', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"vet@codigogarra.vet\",\n  \"password\": \"Vet123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login admin (guarda token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('tokenAdmin', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@codigogarra.vet\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "401 sin token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/alertas"
          }
        }
      ]
    },
    {
      "name": "Módulo 1 — Alertas de Emergencia",
      "item": [
        {
          "name": "Listar alertas",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{tokenVet}}"}],
            "url": "{{baseUrl}}/alertas"
          }
        },
        {
          "name": "Crear alerta",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{tokenVet}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gravedad\": 5,\n  \"requerimiento\": \"Necesita ventilador mecánico urgente\",\n  \"estado\": \"Buscando\"\n}"
            },
            "url": "{{baseUrl}}/alertas"
          }
        },
        {
          "name": "Obtener alerta por ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{tokenVet}}"}],
            "url": "{{baseUrl}}/alertas/1"
          }
        },
        {
          "name": "Actualizar alerta",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{tokenVet}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gravedad\": 5,\n  \"requerimiento\": \"Necesita ventilador mecánico urgente\",\n  \"estado\": \"Atendido\"\n}"
            },
            "url": "{{baseUrl}}/alertas/1"
          }
        },
        {
          "name": "Eliminar alerta (rol admin)",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{tokenAdmin}}"}],
            "url": "{{baseUrl}}/alertas/1"
          }
        },
        {
          "name": "403 eliminar sin rol admin",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{tokenVet}}"}],
            "url": "{{baseUrl}}/alertas/1"
          }
        }
      ]
    },
